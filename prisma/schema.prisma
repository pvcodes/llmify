generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  email              String               @unique
  password           String
  img_url            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  chats              Chat[]
  billing            Billing?
  SupportQuery       SupportQuery[]
  PaypalOrderDetails PaypalOrderDetails[]
}

model Billing {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int          @unique
  paymentOrderId String?      @unique
  level          BillingLevel @default(FREE)
  tokenUsage     Int          @default(0)
  startDate      DateTime     @default(now())
  endDate        DateTime?
  isValid        Boolean      @default(false)
}

model Chat {
  id          String        @id
  name        String?
  messages    Message[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  ChatSummary ChatSummary[]
}

model Message {
  id        String      @id
  content   String
  role      MessageRole
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  chatId    String
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model ChatSummary {
  id      Int    @id @default(autoincrement())
  chatId  String @unique
  chat    Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  summary String
  createdAt DateTime    @default(now())
}

model SupportQuery {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaypalOrderDetails {
  id        Int               @id @default(autoincrement())
  orderId   String            @unique // PayPal order ID
  tier      BillingLevel
  user      User              @relation(fields: [userId], references: [id]) // To link to user
  createdAt DateTime          @default(now())
  status    PaypalOrderStatus // Custom status enum
  userId    Int
}

enum MessageRole {
  system
  user
  assistant
  data
}

enum BillingLevel {
  FREE
  PREMIUM
  ENTERPRISE
}

enum PaypalOrderStatus {
  CREATED
  COMPLETED
  FAILED
}
